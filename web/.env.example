# URL pública del despliegue actual.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ALLOW_INDEXING=false
NEXT_PUBLIC_EMAIL_SIGNUP_ENABLED=false

# Copiar los valores públicos mostrados por `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Secretos de servidor para ejecutar el importador; nunca usar NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
TMDB_READ_ACCESS_TOKEN=replace-with-tmdb-read-access-token

# Solo para sincronizar o probar localmente el proveedor Google de Supabase.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace-with-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Secretos opcionales de servidor para los conectores de fase 5.
GUARDIAN_CONTENT_API_KEY=replace-with-guardian-api-key
INGESTION_CRON_SECRET=replace-with-a-random-server-secret

# Vercel lo envía como Bearer al endpoint semanal de snapshots.
CRON_SECRET=replace-with-another-random-server-secret
