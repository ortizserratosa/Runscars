{
  "name": "runscars",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm --workspace web run dev",
    "postinstall": "node scripts/patch-brace-expansion.mjs",
    "build": "npm --workspace web run build",
    "format": "prettier --check \"web/**/*.{ts,tsx,mjs,css,json,md}\" \"supabase/functions/**/*.{ts,mjs,json}\" \"scripts/**/*.mjs\" package.json .prettierrc.json",
    "format:write": "prettier --write \"web/**/*.{ts,tsx,mjs,css,json,md}\" \"supabase/functions/**/*.{ts,mjs,json}\" \"scripts/**/*.mjs\" package.json .prettierrc.json",
    "audit": "npm audit --audit-level=high",
    "lint": "npm --workspace web run lint",
    "typecheck": "npm --workspace web run typecheck",
    "test": "npm --workspace web run test",
    "test:db": "npm --workspace web run test:db",
    "test:e2e": "npm --workspace web run test:e2e",
    "verify": "npm run format && npm run lint && npm run typecheck && npm run test && npm run test:db && npm run build && npm run audit",
    "db:network": "node scripts/ensure-local-network.mjs",
    "db:start": "npm run db:network && supabase start --network-id runscars-local",
    "db:stop": "supabase stop --network-id runscars-local",
    "db:reset": "supabase db reset --network-id runscars-local",
    "db:lint": "supabase db lint --local --level warning --network-id runscars-local",
    "db:types": "node web/scripts/generate-database-types.mjs && prettier --write web/src/types/database.generated.ts",
    "db:types:supabase": "supabase gen types typescript --local --schema public",
    "tmdb:search": "node web/scripts/tmdb-catalog.mjs search",
    "tmdb:import": "node web/scripts/tmdb-catalog.mjs import",
    "tmdb:match": "node web/scripts/tmdb-catalog.mjs match",
    "candidate:match": "node web/scripts/category-candidate-match.mjs match",
    "ingest:manual": "node web/scripts/ingestion.mjs manual",
    "results:import": "node web/scripts/official-results.mjs import",
    "results:archive": "node web/scripts/official-results.mjs archive",
    "phase8:staging-check": "node web/scripts/phase-8-staging-check.mjs"
  },
  "devDependencies": {
    "brace-expansion": "5.0.9",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "prettier": "3.9.6",
    "supabase": "2.109.1"
  },
  "overrides": {
    "brace-expansion": "$brace-expansion",
    "js-yaml": "4.3.1",
    "postcss": "8.5.26",
    "next": {
      "sharp": "0.35.3"
    },
    "sharp": "0.35.3"
  }
}
